{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tsbuildinfo",
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/extension.ts", "./vite.config.ts"]
}
