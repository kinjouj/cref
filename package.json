{
  "name": "cref",
  "displayName": "cref",
  "description": "Jump to any file referenced via # @path/to/file comment",
  "version": "0.1.0",
  "publisher": "kinjouj",
  "homepage": "https://github.com/kinjouj/cref",
  "repository": {
    "type": "git",
    "url": "https://github.com/kinjouj/cref"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cref.jump",
        "title": "Cref: Jump to Referenced File"
      }
    ],
    "keybindings": [
      {
        "command": "cref.jump",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location=node_modules/.eslintcache",
    "build": "npm run typecheck && npm run lint && vite build && npm run package",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "overrides": {
    "minimatch": "^10.2.6"
  }
}
