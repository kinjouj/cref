{
  "name": "cref",
  "displayName": "cref",
  "description": "Jump to any file referenced via # @path/to/file comment",
  "version": "0.1.0",
  "publisher": "kinjouj",
  "homepage": "https://github.com/kinjouj/cref",
  "repository": {
    "type": "git",
    "url": "https://github.com/kinjouj/cref"
  },
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onLanguage"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cref.jump",
        "title": "Cref: Jump to Referenced File"
      }
    ],
    "keybindings": [
      {
        "command": "cref.jump",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "cref",
      "properties": {
        "cref.enableDocumentLinkProvider": {
          "type": "boolean",
          "default": true,
          "description": "DocumentLinkProviderを有効にする"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location=node_modules/.eslintcache",
    "build": "npm run typecheck && npm run lint && vite build && npm run package",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.146.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
